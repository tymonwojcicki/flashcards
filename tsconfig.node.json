{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.ts",
    "vite.mathlive-fonts.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": false,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  }
}
